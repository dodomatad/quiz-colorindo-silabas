{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "fbclid"
        }
      ],
      "destination": "/oferta.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "utm_source"
        }
      ],
      "destination": "/oferta.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "preview",
          "value": "kevano"
        }
      ],
      "destination": "/oferta.html"
    },
    {
      "source": "/oferta",
      "destination": "/oferta.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
